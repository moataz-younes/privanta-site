# ─── Database (Prisma / PostgreSQL) ─────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/privanta?schema=public"

# ─── Contact API (Next.js) ───────────────────────────────────────────────────
# Public site URL used for CSRF origin validation (must match browser Origin)
NEXT_PUBLIC_APP_URL="https://privanta.net"

# ─── Email (Resend) — server only, never expose to Vite ────────────────────
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="Privanta Leads <leads@privanta.net>"

# ─── Rate limiting (Upstash Redis) — server only ─────────────────────────────
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxxxxx"

# ─── Vite client (safe to expose — no secrets) ───────────────────────────────
VITE_MAIN_SITE_URL="https://privanta.net"
VITE_PLATFORM_SITE_URL="https://platform.privanta.com"
VITE_MAAT_SITE_URL="https://maat.privanta.com"

# ─── Development only ────────────────────────────────────────────────────────
# VITE_DEV_SERVER_URL="http://127.0.0.1:8080"
